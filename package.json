{
  "name": "agents-md-kit",
  "version": "0.1.1",
  "description": "Installs AI-agent configuration (AGENTS.md, skills, memory, presets) into a repository. Dry run by default, never overwrites.",
  "keywords": [
    "agents-md",
    "agents.md",
    "claude-code",
    "ai-agents",
    "coding-agents",
    "skills",
    "scaffold",
    "installer",
    "conventional-commits"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "agents-md-kit": "bin/agent-kit.js"
  },
  "files": [
    "bin/",
    "src/",
    "core/",
    "packs/",
    "presets/",
    "docs/monorepo.md",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "validate:template": "node bin/agent-kit.js validate --template",
    "typecheck": "tsc -p .",
    "check": "npm run typecheck && npm test && npm run validate:template"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rumpz/agents-md-kit.git"
  },
  "homepage": "https://github.com/Rumpz/agents-md-kit#readme",
  "bugs": {
    "url": "https://github.com/Rumpz/agents-md-kit/issues"
  },
  "author": "Rumpz"
}
